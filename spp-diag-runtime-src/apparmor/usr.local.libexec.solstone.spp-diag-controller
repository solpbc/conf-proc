# Parser-checked only: this source is compiled by the focused selftest and is not a
# claim that a live kernel enforces it.  The controller loads this
# exact profile with: apparmor_parser -r -K --abort-on-error <this file>.
#
# The executable attachment is the shipped extensionless PID-1 controller.  There
# are no includes, unconfined transitions, filesystem-wide grants, or administrative caps.

profile /usr/lib/spp/spp-diag-controller {
  /usr/bin/python3.10 ix,
  /usr/lib/spp/spp-diag-controller r,
  /usr/lib/python3.10/conf_proc_reasons.py r,
  /usr/lib/python3.10/conf_proc_json.py r,
  /usr/lib/python3.10/conf_proc_spp_diag_failure_terminal_reasons.py r,
  /usr/lib/python3.10/conf_proc_spp_diag_export.py r,
  /usr/lib/python3.10/conf_proc_spp_diag_export_reasons.py r,
  /usr/lib/python3.10/conf_proc_spp_diag_quote.py r,
  /usr/lib/python3.10/conf_proc_spp_diag_pcr.py r,
  /usr/lib/python3.10/conf_proc_spp_diagbundle_protocol.py r,
  /usr/lib/python3.10/** rm,
  /etc/ld.so.cache r,
  /lib64/ld-linux-x86-64.so.2 mr,
  /lib/x86_64-linux-gnu/** mr,
  /usr/lib/x86_64-linux-gnu/** mr,

  /opt/solstone/bin/synthetic-runtime ix,
  /usr/lib/spp/spp-diag-gpu-evidence.py r,
  /usr/bin/nvattest ix,
  /usr/bin/nvidia-smi ix,
  /usr/bin/tpm2_readpublic ix,
  /usr/bin/tpm2_nvread ix,
  /usr/bin/tpm2_quote ix,
  /dev/null rw,
  /dev/ttyS0 w,
  /dev/tpmrm0 rw,
  /dev/nvidia0 rw,
  /dev/nvidiactl rw,
  /dev/nvidia-uvm rw,
  /dev/nvidia-uvm-tools rw,
  /dev/nvidia-caps/* rw,
  /proc/1/task/1/children r,
  /proc/driver/nvidia/** r,
  /sys/kernel/security/sol_spp_diag_trace/control w,
  /sys/kernel/security/sol_spp_diag_trace/stream r,
  /opt/solstone/models/synthetic-fixture-v1.bin r,
  /var/cache/solstone/jit/synthetic-fixture-v1.so rm,
  /run/spp-diag/gpu-evidence.tlv rw,
  /run/spp-diag/ak-public.pem rw,
  /run/spp-diag/ak-tpmt-public.bin rw,
  /run/spp-diag/hcla.bin rw,
  /run/spp-diag/quote.msg rw,
  /run/spp-diag/quote.sig rw,
  /run/spp-diag/quote.pcrs rw,
  /sys/kernel/security/tpm0/binary_bios_measurements r,
  /sys/kernel/security/ima/binary_runtime_measurements r,

  # Socket creation is restricted to the three probe shapes.  Their only literal
  # outbound operations are denied by peer so the controller records EACCES/EPERM.
  network create inet stream,
  network create inet6 stream,
  network create inet dgram,
  deny network connect inet stream peer=(ip=198.51.100.7 port=443),
  deny network connect inet6 stream peer=(ip=2001:db8::8 port=443),
  deny network send inet dgram peer=(ip=203.0.113.9 port=443),

  deny /var/tmp/solstone-writable-exec x,
  deny /mnt/solstone-attached/foreign-exec x,
  deny /run/solstone/remote-code/foreign-exec x,

  signal (send, receive) set=(term, kill, exists) peer=@{profile_name},
  capability sys_boot,
}
